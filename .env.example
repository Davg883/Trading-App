# The default UI works without credentials using clearly labelled synthetic data.
# Copy to .env.local only when configuring services. Never commit actual secrets.

# Convex deployment setup writes these values (run npx convex dev).
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Identity provider configuration is required before private Convex access.
# Set the actual issuer in convex/auth.config.ts according to your provider.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=

# Trading 212 encrypted vault. Server-only; never use NEXT_PUBLIC_ for these.
# The provider API key/secret are entered on /settings/brokers, not stored here.
CONVEX_BROKER_ADMIN_KEY=
BROKER_VAULT_KEY_B64=
BROKER_VAULT_KEY_VERSION=v1
BROKER_APP_ORIGIN=http://localhost:3000
# Future persistent deployment: bearer secret (32+ chars) for POST /api/brokers/scheduled, called by a platform cron.
BROKER_SCHEDULER_SECRET=

# Trusted research-package import (POST /api/research/import). Server-only Convex deploy/admin key.
CONVEX_IMPORT_ADMIN_KEY=
# Optional; defaults to BROKER_APP_ORIGIN.
RESEARCH_APP_ORIGIN=

# Server-only integration settings. These do not automatically activate feeds.
SEC_USER_AGENT=
FRED_API_KEY=
FMP_API_KEY=
MASSIVE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Pin exact model IDs when implementing/enabling model orchestration.
OPENAI_MODEL=
ANTHROPIC_MODEL=
# Python model runner reads process environment, not this file automatically.
# Optional complete HTTPS endpoint overrides:
# OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
# ANTHROPIC_ENDPOINT=https://api.anthropic.com/v1/messages
# ANTHROPIC_VERSION=2023-06-01


# Licensed analyst ratings worker only. A key does not establish a data licence.
BENZINGA_API_KEY=

# Phase 003: Remote Research Operations (server-only; never expose to browser or agent prompts).
# Dedicated machine token (32+ chars) for POST /api/research/staging only; grants no broker, vault, role or trading access.
RESEARCH_STAGING_TOKEN=
# Optional separate Convex deploy key for staging/operations only (falls back to CONVEX_IMPORT_ADMIN_KEY in local dev).
CONVEX_STAGING_DEPLOY_KEY=
# Bearer secret (32+ chars) for POST /api/operations/scheduled, called by the persistent hosted scheduler.
OPERATIONS_SCHEDULER_SECRET=
# Owner tokenIdentifier for unattended single-owner scheduled research ingestion.
RESEARCH_OWNER_ID=
# Active scheduler environment ('remote' | 'local' | 'disabled') to prevent duplicate local/remote runs.
RESEARCH_SCHEDULER_ENV=remote
# Optional Gemini model configuration for Antigravity SDK / remote research summarisation.
GEMINI_API_KEY=
GEMINI_MODEL=
